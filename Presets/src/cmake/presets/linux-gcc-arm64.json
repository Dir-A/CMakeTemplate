{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "linux-gcc-arm64-dbg",
      "displayName": "Linux GCC ARM64 Debug",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_SYSTEM_PROCESSOR": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-linux-dynamic"
      }
    },
    {
      "name": "linux-gcc-arm64-dbg-static-md",
      "displayName": "Linux GCC ARM64 Debug Static MD",
      "inherits": "linux-gcc-arm64-dbg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux"
      }
    },
    {
      "name": "linux-gcc-arm64-rel",
      "displayName": "Linux GCC ARM64 Release",
      "inherits": "linux-gcc-arm64-dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-arm64-minsizerel",
      "displayName": "Linux GCC ARM64 MinSizeRel",
      "inherits": "linux-gcc-arm64-rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "linux-gcc-arm64-relwithdebinfo",
      "displayName": "Linux GCC ARM64 RelWithDebInfo",
      "inherits": "linux-gcc-arm64-rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-gcc-arm64-rel-static-md",
      "displayName": "Linux GCC ARM64 Release Static MD",
      "inherits": "linux-gcc-arm64-rel",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux"
      }
    },
    {
      "name": "linux-gcc-arm64-minsizerel-static-md",
      "displayName": "Linux GCC ARM64 MinSizeRel Static MD",
      "inherits": "linux-gcc-arm64-rel-static-md",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "linux-gcc-arm64-relwithdebinfo-static-md",
      "displayName": "Linux GCC ARM64 RelWithDebInfo Static MD",
      "inherits": "linux-gcc-arm64-rel-static-md",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}
