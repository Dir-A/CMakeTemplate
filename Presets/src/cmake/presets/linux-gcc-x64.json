{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "linux-gcc-x64-dbg",
      "displayName": "Linux GCC x64 Debug",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64 ",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "linux-gcc-x64-dbg-static-md",
      "displayName": "Linux GCC x64 Debug Static MD",
      "inherits": "linux-gcc-x64-dbg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-x64-rel",
      "displayName": "Linux GCC x64 Release",
      "inherits": "linux-gcc-x64-dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-x64-minsizerel",
      "displayName": "Linux GCC x64 MinSizeRel",
      "inherits": "linux-gcc-x64-rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "linux-gcc-x64-relwithdebinfo",
      "displayName": "Linux GCC x64 RelWithDebInfo",
      "inherits": "linux-gcc-x64-rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-gcc-x64-rel-static-md",
      "displayName": "Linux GCC x64 Release Static MD",
      "inherits": "linux-gcc-x64-rel",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-x64-minsizerel-static-md",
      "displayName": "Linux GCC x64 MinSizeRel Static MD",
      "inherits": "linux-gcc-x64-rel-static-md",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "linux-gcc-x64-relwithdebinfo-static-md",
      "displayName": "Linux GCC x64 RelWithDebInfo Static MD",
      "inherits": "linux-gcc-x64-rel-static-md",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}
