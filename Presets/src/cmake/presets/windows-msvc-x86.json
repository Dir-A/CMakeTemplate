{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "windows-msvc-x86-dbg",
      "displayName": "Windows MSVC x86 Debug",
      "inherits": "windows-msvc-base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x86-windows"
      }
    },
    {
      "name": "windows-msvc-x86-dbg-static-mt",
      "displayName": "Windows MSVC x86 Debug Static MT",
      "inherits": "windows-msvc-x86-dbg",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug",
        "VCPKG_TARGET_TRIPLET": "x86-windows-static"
      }
    },
    {
      "name": "windows-msvc-x86-rel",
      "displayName": "Windows MSVC x86 Release",
      "inherits": "windows-msvc-x86-dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-x86-msr",
      "displayName": "Windows MSVC x86 MinSizeRel",
      "inherits": "windows-msvc-x86-dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "windows-msvc-x86-rwi",
      "displayName": "Windows MSVC x86 RelWithDebInfo",
      "inherits": "windows-msvc-x86-dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-msvc-x86-rel-static-mt",
      "displayName": "Windows MSVC x86 Release Static MT",
      "inherits": "windows-msvc-x86-rel",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "VCPKG_TARGET_TRIPLET": "x86-windows-static"
      }
    },
    {
      "name": "windows-msvc-x86-msr-static-mt",
      "displayName": "Windows MSVC x86 MinSizeRel Static MT",
      "inherits": "windows-msvc-x86-rel-static-mt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "windows-msvc-x86-rwi-static-mt",
      "displayName": "Windows MSVC x86 RelWithDebInfo Static MT",
      "inherits": "windows-msvc-x86-rel-static-mt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}
